---
import { pct, type AgreementRow } from "./reviews";

interface Props {
  sentiments: string[];
  rows: AgreementRow[];
}

const { sentiments, rows } = Astro.props;
const agrees = (stars: string, s: string) => (stars === "1–2★" && s === "negative") || (stars === "4–5★" && s === "positive");
const sum = (r: AgreementRow) => r.counts.reduce((n, c) => n + c, 0);
const label =
  "Model sentiment against star ratings for 2,400 reviews. " +
  rows.map((r) => `${r.stars}, ${sum(r)} reviews: ` + sentiments.map((s, i) => `${s} ${r.counts[i]}`).join(", ") + ".").join(" ");
---

<figure class="fig">
  <div class="panel" role="img" aria-label={label}>
    <div class="grid" style={`grid-template-columns: 70px repeat(${sentiments.length}, minmax(0, 1fr))`}>
      <span class="corner">stars ↓ model →</span>
      {sentiments.map((s) => <strong class="col">{s}</strong>)}
      {
        rows.map((r) => (
          <>
            <strong class="rowh">{r.stars}<small>{sum(r)}</small></strong>
            {r.counts.map((n, i) => (
              <span
                class:list={["cell", { agree: agrees(r.stars, sentiments[i]) }]}
                style={`--a:${Math.round((50 * n) / sum(r))}%`}
              >
                <b>{n}</b>
                <small>{pct(n, sum(r))}</small>
              </span>
            ))}
          </>
        ))
      }
    </div>
  </div>
  <figcaption>The model's sentiment for each review against its stars; shade is the share of the row. Outlined cells are where the two agree.</figcaption>
</figure>

<style>
  .fig { margin: 1.4em 0 2em; }
  .panel { background: var(--surface); border: 1px solid var(--line); border-radius: 18px; padding: 18px 20px; box-shadow: var(--shadow); }
  .grid { display: grid; gap: 6px; align-items: stretch; }
  .corner { font-size: 0.7rem; color: var(--muted); align-self: end; }
  .col { font-size: 0.82rem; text-align: center; align-self: end; padding-bottom: 4px; }
  .rowh { display: grid; align-content: center; font-size: 0.95rem; }
  .rowh small { font-size: 0.72rem; font-weight: 600; color: var(--muted); }
  .cell { display: grid; place-content: center; text-align: center; min-height: 58px; border-radius: 10px; border: 2px solid transparent; background: color-mix(in srgb, var(--teal) var(--a), var(--tint)); }
  .cell b { font-size: 1rem; font-variant-numeric: tabular-nums; }
  .cell small { font-size: 0.72rem; }
  .agree { border-color: var(--ink); }
  figcaption { color: var(--muted); font-size: 0.88rem; text-align: center; margin-top: 12px; }
  @media (max-width: 520px) {
    .panel { padding: 14px 10px; }
    .grid { grid-template-columns: 52px repeat(4, minmax(0, 1fr)) !important; gap: 4px; }
    .col { font-size: 0.7rem; }
  }
</style>
