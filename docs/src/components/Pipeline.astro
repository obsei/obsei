---
const sources = ["App Store", "Google Play", "Zendesk", "Intercom", "Gong", "GitHub", "Bluesky", "SQL", "Webhooks", "REST", "MCP"];
const outputs = ["Studio", "Agents (MCP)", "Slack", "Jira", "Linear", "Warehouse"];
const steps = [
  { name: "Redact", note: "PII and names", href: "/privacy/overview/" },
  { name: "Classify", note: "your model", href: "/guides/models/" },
  { name: "Theme", note: "across languages", href: "/guides/themes/" },
  { name: "Store", note: "encrypted DuckDB", href: "/configuration/" },
];
---

<figure class="pipeline not-content" aria-label="obsei pipeline: sources flow into your infrastructure, where data is redacted, classified, themed and stored, then reaches Studio, agents and sinks">
  <div class="lane">
    <p class="title"><a href="/guides/sources/">Collect</a></p>
    <ul class="pills">{sources.map((s) => <li>{s}</li>)}</ul>
  </div>
  <div class="link" aria-hidden="true"><span></span></div>
  <div class="boundary">
    <p class="title">Your infrastructure</p>
    <ol class="steps">
      {steps.map((s) => (
        <li>
          <a href={s.href}><strong>{s.name}</strong><span>{s.note}</span></a>
        </li>
      ))}
    </ol>
  </div>
  <div class="link" aria-hidden="true"><span></span></div>
  <div class="lane">
    <p class="title"><a href="/guides/sinks/">Act</a></p>
    <ul class="pills out">{outputs.map((s) => <li>{s}</li>)}</ul>
  </div>
</figure>

<style>
  .pipeline {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) 40px minmax(0, 1.6fr) 40px minmax(0, 0.9fr);
    align-items: center;
    margin: 2rem 0;
  }
  .title {
    margin: 0 0 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sl-color-gray-3);
  }
  .title a {
    color: inherit;
    text-decoration: none;
  }
  .pills {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem;
  }
  .pills li {
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 999px;
    padding: 0.15rem 0.65rem;
    font-size: 0.8rem;
    white-space: nowrap;
  }
  .pills.out li {
    border-color: var(--sl-color-accent);
    color: var(--sl-color-accent-high);
    font-weight: 600;
  }
  .boundary {
    border: 2px dashed var(--sl-color-accent);
    border-radius: 1.25rem;
    padding: 1rem;
    background: var(--sl-color-accent-low);
  }
  .boundary .title {
    color: var(--sl-color-accent-high);
  }
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
  }
  .steps a {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: 0.15rem;
    padding: 0.75rem 0.4rem;
    border-radius: 0.75rem;
    background: var(--sl-color-black);
    border: 1px solid var(--sl-color-gray-5);
    color: var(--sl-color-white);
    text-decoration: none;
  }
  .steps a:hover {
    border-color: var(--sl-color-accent);
  }
  .steps strong {
    font-size: 0.95rem;
  }
  .steps span {
    font-size: 0.75rem;
    line-height: 1.3;
    color: var(--sl-color-gray-3);
  }
  .link {
    height: 2px;
    background: var(--sl-color-gray-5);
    position: relative;
    overflow: hidden;
  }
  .link span {
    position: absolute;
    top: -2px;
    left: 0;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--sl-color-accent);
    animation: flow 2.4s linear infinite;
  }
  @keyframes flow {
    to {
      transform: translateX(40px);
    }
  }
  @keyframes flow-down {
    to {
      transform: translateY(32px);
    }
  }
  @media (max-width: 64rem) {
    .pipeline {
      grid-template-columns: minmax(0, 1fr);
    }
    .link {
      width: 2px;
      height: 32px;
      justify-self: center;
    }
    .link span {
      animation-name: flow-down;
    }
  }
  @media (max-width: 30rem) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .link span {
      animation: none;
    }
  }
</style>
