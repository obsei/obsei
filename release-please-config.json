{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "include-component-in-tag": false,
  "packages": {
    "packages/obsei": {
      "release-type": "python",
      "release-as": "1.0.0-rc.1",
      "package-name": "obsei",
      "changelog-path": "CHANGELOG.md",
      "extra-files": [
        "src/obsei/_version.py",
        {
          "type": "json",
          "path": "/integrations/claude/obsei/.claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "generic",
          "path": "README.md"
        },
        {
          "type": "generic",
          "path": "/README.md"
        },
        {
          "type": "generic",
          "path": "/docs/src/content/docs/quickstart.md"
        }
      ]
    }
  },
  "versioning": "prerelease",
  "prerelease": true,
  "prerelease-type": "rc"
}
